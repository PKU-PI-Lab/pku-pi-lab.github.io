  "research": {
    "slides": [
      {
        "img": "images/pubs/res_embodied.jpg",
        "alt": "Embodied AI for cable manipulation scenarios",
        "title_en": "Embodied AI Models &amp; Robot Learning",
        "title_zh": "具身智能模型与机器人学习",
        "desc_en": "Multimodal embodied foundation models (VLA / world models / PAM), imitation and reinforcement learning for contact-rich manipulation, sim-to-real transfer, and reliable long-horizon task planning through physics-semantics-driven agent clusters (PySAC).",
        "desc_zh": "多模态具身基础模型（VLA / 世界模型 / PAM）、面向富接触操作的模仿与强化学习、仿真到真实的迁移，以及通过物理语义驱动的智能体集群（PySAC）实现可靠的长程任务规划。"
      }
    ]
  },
